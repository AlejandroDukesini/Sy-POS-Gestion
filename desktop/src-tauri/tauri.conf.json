{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "POS-PY",
  "version": "1.0.0",
  "identifier": "com.pospy.app",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis", "msi"],
    "publisher": "POS-PY",
    "category": "Business",
    "shortDescription": "Punto de venta y control de inventario",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"],
    "externalBin": ["binaries/pospy-server"],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser", "languages": ["Spanish"] },
      "wix": { "language": "es-ES" }
    }
  }
}
