    "@types/react": "18.3.26",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "eslint": "9.38.0",
    "eslint-plugin-react-hooks": "5.2.0",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "playwright-core": "^1.49.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.46.2",
